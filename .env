# Configuration de la base de données PostgreSQL pour OMEGA
# Ce fichier est utilisé par le script de sauvegarde automatique

# Nom de la base de données
POSTGRES_DB=omega

# Utilisateur PostgreSQL
POSTGRES_USR=postgres

# Mot de passe PostgreSQL (à remplacer par votre mot de passe réel)
POSTGRES_PWD=postgres

# Hôte PostgreSQL (localhost pour une installation locale)
POSTGRES_HOST=localhost

# Port PostgreSQL (5432 par défaut)
POSTGRES_PORT=5432

# Configuration JWT (déjà présente dans backend/.env.developpement.developpement)
JWT_SECRET=Omega-28!
JWT_EXPIRY=4h
FRONTEND_URL=http://localhost:3001
