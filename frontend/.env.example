# Configuration de l'application

# ============================================
# MODE DE TUILES CARTOGRAPHIQUES
# ============================================
# Détermine si l'application utilise des tuiles en ligne (IGN) ou hors-ligne (locales)
#
# Valeurs possibles :
#   - 'online'  : Tuiles chargées depuis IGN Géoportail (https://data.geopf.fr)
#   - 'local'   : Tuiles pré-téléchargées stockées dans /public/tiles/
#
# ⚠️ IMPORTANT DDT : Pour une installation sans accès internet, utilisez 'local'
#
# Par défaut : 'online'
REACT_APP_TILE_MODE=online

# ============================================
# INSTRUCTIONS POUR MODE HORS-LIGNE (DDT)
# ============================================
#
# 1. Télécharger les tuiles locales :
#    cd donnees
#    python3 download_tiles.py all
#
# 2. Modifier cette variable :
#    REACT_APP_TILE_MODE=local
#
# 3. Copier ce fichier :
#    cp .env.example .env.local
#
# 4. Rebuild l'application :
#    npm run build
#
# Pour plus de détails, consultez : donnees/TUILES_LOCALES.md

# ============================================
# URL DE L'API BACKEND
# ============================================
# URL du serveur backend (optionnel)
# Par défaut : http://localhost:3000
# REACT_APP_API_URL=http://localhost:3000
