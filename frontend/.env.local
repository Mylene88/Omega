# Configuration LOCAL - Frontend OMEGA
# Pour utilisation directe sur le serveur (localhost)

JWT_SECRET=Omega-28!
PORT=3001

# URL de l'API backend en LOCAL
REACT_APP_API_URL=http://localhost:3000

# Mode des tuiles cartographiques
REACT_APP_TILE_MODE=local

# URL publique du frontend
PUBLIC_URL=/

# Sécurité et optimisation
DANGEROUSLY_DISABLE_HOST_CHECK=true
GENERATE_SOURCEMAP=false

# Mode production
NODE_ENV=production

CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=1000
