# ============================================
# Configuration Production - Frontend OMEGA
# ============================================
# Serveur Omega (environnement cloisonné DDT)
# Déploiement : omega/deploy/frontend

# Port du frontend en production
PORT=3001

# URL de l'API backend en production
# Le backend tourne sur le serveur Omega (10.28.8.236)
REACT_APP_API_URL=http://10.28.8.236:3000

# Mode des tuiles cartographiques
# OBLIGATOIRE en environnement cloisonné : utilise les tuiles locales
REACT_APP_TILE_MODE=local

# URL publique du frontend
PUBLIC_URL=http://10.28.8.236:3001

# Sécurité et optimisation
DANGEROUSLY_DISABLE_HOST_CHECK=true
GENERATE_SOURCEMAP=false

# Mode production
NODE_ENV=production