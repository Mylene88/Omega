# ============================================
# Configuration Production - Frontend OMEGA
# ============================================
#
# Copier ce fichier vers .env.production et ajuster les valeurs
# cp .env.production.example .env.production

# URL de l'API backend
# En production, remplacer par l'URL réelle du serveur
REACT_APP_API_URL=http://votre-serveur-production:3000

# Mode des tuiles cartographiques
# - 'online' : télécharge les tuiles depuis Internet (IGN/OpenStreetMap)
# - 'local' : utilise les tuiles pré-téléchargées (OBLIGATOIRE pour DDT cloisonnée)
REACT_APP_TILE_MODE=local

# URL publique du frontend (optionnel, pour les assets)
PUBLIC_URL=http://votre-serveur-production:3001

# Mode Node.js (automatique avec `npm run build`)
# NODE_ENV=production
